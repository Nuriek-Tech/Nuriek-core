generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  personalEmail String?   @unique
  password      String?
  role          String    @default("EMPLOYEE")
  onboardingStatus String @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
  attendance    Attendance[]
  leaves        Leave[]
  timesheets    Timesheet[]
  reviews       PerformanceReview[] @relation("UserReviews")
  reviewed      PerformanceReview[] @relation("Reviewer")
  badges        Badge[]
  signatures    Signature[]
  internPerformance InternPerformance?
}

model PerformanceReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer  User     @relation("Reviewer", fields: [reviewerId], references: [id])
  rating    Int
  feedback  String
  createdAt DateTime @default(now())
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String   // Lucide icon name
  awardedBy String
  awardedAt DateTime @default(now())
}

model Timesheet {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  tasks       String   // JSON string or long text of tasks
  hours       Float    @default(8.0)
  status      String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  position    String?
  department  String?
  joinDate    DateTime @default(now())
  address     String?
  bio         String?
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn    DateTime @default(now())
  checkOut   DateTime?
  status     String   @default("PRESENT") // PRESENT, LATE, ABSENT, ON_LEAVE
  location   String?
  note       String?
  createdAt  DateTime @default(now())
}

model Leave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // SICK, CASUAL, MATERNITY, PATERNITY, UNPAID
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  title        String
  description  String?
  url          String   // URL to the PDF
  type         String   // POLICY, LEGAL, DRIVE
  category     String?  // Folder name for Drive
  size         Int      @default(0) // File size in bytes
  allowedRoles String   @default("ALL") // Comma separated roles
  targetUserId String?  // Specific user this doc is for (e.g. Offer Letter)
  status       String   @default("PENDING") // PENDING, PARTIALLY_SIGNED, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  signatures   Signature[]
  requiredSigners RequiredSigner[]
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  type      String   @default("PUBLIC") // PUBLIC, OPTIONAL, COMPANY
  createdAt DateTime @default(now())
}

model InternPerformance {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningProgress  Int      @default(0)
  taskCompletion    Int      @default(0)
  score             Int      @default(0)
  duration          String?  // e.g., "Month 2 of 6"
  conversionRisk    String   @default("LOW") // LOW, MEDIUM, HIGH
  onboardingData    String   @default("[]") // JSON string for checklist
  updatedAt         DateTime @updatedAt
}

model RequiredSigner {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String?  // Optional if the user isn't in the portal yet
  email      String   // Required for identification
  role       String   @default("SIGNER") // e.g., HR_HEAD, DIRECTOR, EMPLOYEE
  signedAt   DateTime?
  order      Int      @default(0) // If you want a specific order of signing
}

model Signature {
  id         String   @id @default(cuid())
  userId     String?  // Optional for guests
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?  // Identify the signer by email if userId is missing
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signature  String   // Base64 string of the signature image
  signedAt   DateTime @default(now())
  
  @@unique([userId, documentId])
}
model SystemConfig {
  id            String   @id @default("global")
  workStartHour Int      @default(9)
  workStartMin  Int      @default(0)
  workEndHour   Int      @default(18)
  workEndMin    Int      @default(0)
  flexibleRoles String   @default("INTERN") // Comma separated roles
  updatedAt     DateTime @updatedAt
}

model OrgTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  publishedBy String
  createdAt   DateTime @default(now())
}
