# Database (Neon)
DATABASE_URL="postgresql://...@ep-xxx-pooler....neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://...@ep-xxx....neon.tech/neondb?sslmode=require"

# Auth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
PORTAL_PUBLIC_URL="http://localhost:3000"

# Zoho Mail SMTP (offer letters, onboarding, document notifications)
# Use the FULL mailbox address and an App Password — NOT your web login password.
ZOHO_USER="admin@nuriek.com"
ZOHO_PASSWORD="your-16-char-app-password"
ZOHO_FROM_NAME="nuriek"
# India (default): smtp.zoho.in — US/global: smtp.zoho.com
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"
