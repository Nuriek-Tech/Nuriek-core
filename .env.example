# Database — local Docker OR Neon (see README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuriek_core"
# Neon only: direct connection for migrations (non-pooler host)
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
# Public portal URL in emails (onboarding, offer links) — never localhost
PORTAL_PUBLIC_URL="https://www.core.nuriek.com"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32-output"

# Optional: fallback office label (overridden by Admin Settings when set)
NEXT_PUBLIC_OFFICE_NAME="Bangalore (HQ)"

# Zoho SMTP (offer letters, onboarding, notifications)
# Use the FULL mailbox address. Password must be a Zoho *App Password* (not web login).
# Zoho Mail → Security → App passwords → generate for "Nuriek Core"
ZOHO_USER="admin@nuriek.com"
ZOHO_PASSWORD="your-zoho-app-password"
ZOHO_FROM_NAME="nuriek"
# India (default): smtp.zoho.in — US/global: smtp.zoho.com — EU: smtp.zoho.eu
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"
# Optional alias for PORTAL_PUBLIC_URL
# EMAIL_PUBLIC_URL="https://www.core.nuriek.com"
